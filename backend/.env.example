# Port d'écoute du serveur Express
PORT=3001

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:5173

# Supabase — Récupérer depuis : Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # NE PAS exposer côté client

# JWT — Générer avec : openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars

# Resend (emails de bienvenue) — resend.com
# Free tier : 3 000 emails/mois, 100/jour
# Configurer le domaine "adoptly.fr" dans le dashboard Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
