{
  "rewrites": [
    { "source": "/share/animal/:id", "destination": "https://adoptly-backend-p2os.onrender.com/api/public/share/animal/:id" },
    { "source": "/share/article/:slug", "destination": "https://adoptly-backend-p2os.onrender.com/api/public/share/article/:slug" },
    { "source": "/share/animaux", "destination": "https://adoptly-backend-p2os.onrender.com/api/public/share/animaux" },
    { "source": "/sitemap.xml", "destination": "https://adoptly-backend-p2os.onrender.com/sitemap.xml" },
    { "source": "/chiens-a-adopter", "destination": "https://adoptly-backend-p2os.onrender.com/chiens-a-adopter" },
    { "source": "/chats-a-adopter", "destination": "https://adoptly-backend-p2os.onrender.com/chats-a-adopter" },
    { "source": "/animaux-a-adopter", "destination": "https://adoptly-backend-p2os.onrender.com/animaux-a-adopter" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
